POSTGRES_DB=nexa
POSTGRES_USER=nexa_admin
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# 서비스별 DB 계정 비밀번호
USER_DB_PASSWORD=
LEAVE_DB_PASSWORD=
APPROVAL_DB_PASSWORD=
ATTENDANCE_DB_PASSWORD=
PAYROLL_DB_PASSWORD=
MIGRATION_DB_PASSWORD=
AI_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Eureka 계정
EUREKA_USER=
EUREKA_PASSWORD=

# Config-server
CONFIG_GIT_URI=git@github.com:pshyun129/nexa-config.git
CONFIG_GIT_PRIVATE_KEY=
GITHUB_SSH_HOST_KEY=
CONFIG_SERVER_PASSWORD=

# Grafana 계정
GRAFANA_DB_PASSWORD=

# Redis 서비스별 인증
REDIS_USER_SERVICE_PASSWORD=
REDIS_GATEWAY_PASSWORD=

# GMS (FastAPI·Migration 공용)
GMS_API_KEY=

# AI 외부 모델 연동 (사용하는 기능만 설정)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
OCR_BASE_URL=
MLFLOW_TRACKING_URI=

# 웹 클라이언트를 제공하는 주소에 맞게 설정
CORS_ALLOWED_ORIGINS=http://localhost:5173
